#!/usr/bin/env bash

set -u

LEFT_DIR="${1:-/home/jiongming/desktop/dpv}"
RIGHT_DIR="${2:-/home/jiongming/desktop/dynamic/sources/dpv_fixed_by_codex}"
OUTPUT_FILE="${3:-/home/jiongming/desktop/dpv_diff.patch}"

for dir in "$LEFT_DIR" "$RIGHT_DIR"; do
    if [[ ! -d "$dir" ]]; then
        echo "错误：目录不存在：$dir" >&2
        exit 2
    fi
done

mkdir -p "$(dirname "$OUTPUT_FILE")"

LC_ALL=C diff -ruN --exclude=.git -- "$LEFT_DIR" "$RIGHT_DIR" >"$OUTPUT_FILE"
diff_status=$?

case "$diff_status" in
    0)
        echo "两个目录内容一致；空的 diff 结果已保存到：$OUTPUT_FILE"
        ;;
    1)
        echo "发现目录差异；diff 结果已保存到：$OUTPUT_FILE"
        ;;
    *)
        echo "错误：diff 执行失败（退出码：$diff_status）" >&2
        exit "$diff_status"
        ;;
esac

