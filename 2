#!/usr/bin/env bash
set -euo pipefail

scriptDir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
coreVVerifDir="$(cd -- "$scriptDir/../.." && pwd -P)"

export CORE_V_VERIF="$coreVVerifDir"
export CV_CORE="cv32e40x"

export CV_CORE_PKG="$coreVVerifDir/core-v-cores/cv32e40x"
export DESIGN_RTL_DIR="$CV_CORE_PKG/rtl"

export DV_UVMT_PATH="$coreVVerifDir/cv32e40x/tb/uvmt"
export DV_UVME_PATH="$coreVVerifDir/cv32e40x/env/uvme"
export DV_UVMA_PATH="$coreVVerifDir/lib/uvm_agents"
export DV_UVM_TESTCASE_PATH="$coreVVerifDir/cv32e40x/tests/uvmt"
export DV_ISA_DECODER_PATH="$coreVVerifDir/lib/isa_decoder"
export DV_SUPPORT_PATH="$coreVVerifDir/lib/support"

export FV_DEFINES=""
export FV_INCDIRS=""

requiredPaths=(
    "$CV_CORE_PKG/cv32e40x_manifest.flist"
    "$DESIGN_RTL_DIR"
    "$DV_UVMT_PATH"
    "$DV_UVME_PATH"
    "$DV_UVMA_PATH"
    "$DV_ISA_DECODER_PATH"
    "$DV_SUPPORT_PATH"
)

for requiredPath in "${requiredPaths[@]}"; do
    if [[ ! -e "$requiredPath" ]]; then
        echo "ERROR: required path does not exist: $requiredPath" >&2
        exit 1
    fi
done

cd "$scriptDir"
exec your_formal_tool -f "$scriptDir/fv.flist" "$@"
