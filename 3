#include <iostream>
#include <fstream>
#include <string>

/**
 * Locate the first line containing "property_result" in the log file.
 * Strip the leading number (e.g. "1 "), print only up to the comma
 * before "cex", and return immediately.
 *
 * Example input line:
 *   1 property_result(engine='bmc3', prop_no=0, result='failed', depth=0, cex=[...])
 * Output:
 *   property_result(engine='bmc3', prop_no=0, result='failed', depth=0
 *
 * Returns true on success, false if no property_result line was found.
 */
bool print_property_result(const std::string& filepath)
{
    std::ifstream fin(filepath);
    if (!fin.is_open()) {
        std::cerr << "Error: cannot open file \"" << filepath << "\"" << std::endl;
        return false;
    }

    std::string line;
    while (std::getline(fin, line))
    {
        // locate the property_result marker
        size_t pos = line.find("property_result");
        if (pos == std::string::npos)
            continue;

        // strip the leading number (e.g. "1 ")
        std::string content = line.substr(pos);

        // cut off at ", cex" so cex data is not printed
        size_t cex_pos = content.find(", cex");
        if (cex_pos != std::string::npos)
            content = content.substr(0, cex_pos);

        std::cout << content << std::endl;
        fin.close();
        return true;
    }

    fin.close();
    std::cerr << "Info: no \"property_result\" line found in \"" << filepath << "\"" << std::endl;
    return false;
}




