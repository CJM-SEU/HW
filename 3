static std::string strip_and_cut(const std::string& line, size_t keyword_pos)
{
    // remove the leading number (e.g. "1 ")
    std::string content = line.substr(keyword_pos);

    // cut off at ", cex" so cex data is not printed
    size_t cex_pos = content.find(", cex");
    if (cex_pos != std::string::npos)
        content = content.substr(0, cex_pos);

    return content;
}

/**
 * Locate the first line containing "property_result" or "json_result"
 * in the log file. Strip the leading number, print only up to the comma
 * before "cex", and return immediately.
 *
 * Returns true on success, false if neither keyword was found.
 */
bool print_result(const std::string& filepath)
{
    std::ifstream fin(filepath);
    if (!fin.is_open()) {
        std::cerr << "Error: cannot open file \"" << filepath << "\"" << std::endl;
        return false;
    }

    std::string line;
    while (std::getline(fin, line))
    {
        // try property_result
        size_t pos = line.find("property_result");
        if (pos != std::string::npos) {
            std::cout << strip_and_cut(line, pos) << std::endl;
            fin.close();
            return true;
        }

        // try json_result
        pos = line.find("json_result");
        if (pos != std::string::npos) {
            std::cout << strip_and_cut(line, pos) << std::endl;
            fin.close();
            return true;
        }
    }

    fin.close();
    std::cerr << "Info: no \"property_result\" or \"json_result\" line found in \""
              << filepath << "\"" << std::endl;
    return false;
}

int main(int argc, char* argv[])
{
    const char* path = (argc >= 2) ? argv[1] : "test/deep.log";
    bool ok = print_result(path);
    return ok ? 0 : 1;
}
