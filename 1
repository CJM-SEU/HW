diff -ruN '--exclude=.git' -- a/src/main/meson.build b/src/main/meson.build
--- a/src/main/meson.build	2026-08-04 11:51:03.191438141 +0800
+++ b/src/main/meson.build	2026-08-03 20:19:55.000000000 +0800
@@ -2,11 +2,13 @@
 # Build Bitwuzla binary
 # ---
 
-# Build static binary
+# 离线动态构建适配：不强制 -static。原逻辑 build_static 时 link_args += '-static'，
+# 使 -lm/-lpthread/-lc 只按【静态归档】搜索（ld 只找 libm.a/libpthread.a/libc.a），
+# CentOS 7 目标机无 glibc-static 直接报 cannot find -lm/-lpthread/-lc。
+# 去掉后按动态解析，由 build_all.sh 在 $SYSROOT/lib 生成的 GNU ld script 存根
+# （GROUP libm.so.6 等）解决。bitwuzla 库本体仍静态（libbitwuzla.a），
+# 仅最终可执行文件为动态链接。
 link_args = []
-if build_static and host_machine.system() != 'darwin'
-  link_args += ['-static']
-endif
 
 sources = ['main.cpp', 'options.cpp', 'time_limit.cpp']
 
diff -ruN '--exclude=.git' -- a/src/meson.build b/src/meson.build
--- a/src/meson.build	2026-08-04 11:51:03.191438141 +0800
+++ b/src/meson.build	2026-08-03 20:18:11.000000000 +0800
@@ -6,14 +6,20 @@
 # ---
 
 # External dependencies
+# 离线动态构建适配：gmp/mpfr 必须 shared 链接。static: true 时 meson 会在
+# 可执行文件链接命令中插入 `-static`，使 -lm/-lpthread/-lc 按【静态归档】
+# 搜索（ld 只找 libm.a/libpthread.a/libc.a，完全忽略 $SYSROOT/lib 下的
+# .so ld script 存根）。CentOS 7 目标机无 glibc-static，直接报
+# cannot find -lm/-lpthread/-lc。改 shared 后 -lm 等走动态解析，由
+# build_all.sh 在 $SYSROOT/lib 生成的 GNU ld script 存根（GROUP libm.so.6 等）解决。
 gmp_dep = dependency('gmp',
                      version: '>=6.3',
                      required: true,
-                     static: build_static)
+                     static: false)
 mpfr_dep = dependency('mpfr',
                      version: '>=4.2.1',
                      required: true,
-                     static: build_static)
+                     static: false)
 
 # MPFR's .pc has a bare '-lgmp' but no -L for GMP. If GMP is in a separate
 # prefix (e.g. Homebrew), add its libdir so the linker can find libgmp.
