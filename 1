#!/usr/bin/env bash
# Run every benchmark property through the full dpv flow (assume check + mul
# abstraction + verified simplify + solve), one dpv invocation PER
# PROPERTY, in parallel, and summarize.
#
# Why per-property:
#   * dpv is a single-property engine; --property N prunes preprocessing DCE to that bad's
#     cone, so the other properties' logic -- their multipliers above all -- is
#     gone before any later operation runs. Most properties in this suite become
#     pure boolean problems that way (616_dd_00_a: 7 of its 8 drop 35 muls to 0).
#   * It makes engine comparisons honest. Solving a whole model, the bitwuzla
#     frontend has different scheduling and preprocessing behaviour.
#     Per-property, every invocation reports exactly one verdict, so Bitwuzla
#     and bitblast+Kissat are measured on the same footing.
#
# Comparing the two engines (same properties, same budgets):
#   OUT_DIR=bench-bzla DPV_FLAGS="--solve-engine bitwuzla" scripts/benchmark.sh
#   OUT_DIR=bench-both scripts/benchmark.sh        # defaults to the portfolio
#
# The release profiles are taken from doc/benchmark.md:
#   * 412*:               both, -t 4000, preprocessing 3000, PAR=4
#   * 616*:               both + algebra,SCA, -t 1800, PAR=4
# Root-level files outside the 412/616 release suites are skipped.
#
# Usage:   scripts/benchmark.sh
# Env vars (all optional):
#   DPV_BIN     dpv binary                    (default build/dpv)
#   BENCH_DIR   directory of *.btor           (default benchmark/)
#   OUT_DIR     where logs+summary go         (default bench-results/)
#   TIMEOUT     override each profile's dpv -t and outer guard
#   PAR         override each profile's outer parallelism
#   JOBS        analysis/simulation workers per dpv (default 1; final solver
#                                                    portfolio is always 1 or 2)
#   DPV_FLAGS   extra dpv flags appended after the profile flags
set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="${DPV_BIN:-$ROOT/build/dpv}"
BENCH_DIR="${BENCH_DIR:-$ROOT/benchmark}"
OUT_DIR="${OUT_DIR:-$ROOT/bench-results}"
TIMEOUT="${TIMEOUT:-}"
PAR="${PAR:-}"
JOBS="${JOBS:-1}"
DPV_FLAGS="${DPV_FLAGS:-}"

# GNU coreutils timeout (Linux `timeout`, macOS Homebrew `gtimeout`).
TO=timeout
command -v "$TO" >/dev/null 2>&1 || TO=gtimeout
command -v "$TO" >/dev/null 2>&1 || { echo "need coreutils 'timeout'"; exit 1; }
[ -x "$BIN" ] || { echo "dpv binary not found: $BIN"; exit 1; }
ls "$BENCH_DIR"/*.btor >/dev/null 2>&1 || { echo "no *.btor in $BENCH_DIR"; exit 1; }
mkdir -p "$OUT_DIR/logs"
SUMMARY="$OUT_DIR/summary.tsv"

# Verdict/statistics extraction for one property. $1 = log, $2 = exit code.
# Sets g_status g_sat g_unsat g_unknown g_abs g_merged g_constraints g_risky.
scan_log() {
  local log="$1" rc="$2"
  g_sat=$(grep -c ' satisfiable\.' "$log")      # leading space avoids "unsat"
  g_unsat=$(grep -c 'unsatisfiable\.' "$log")
  g_unknown=$(grep -c 'Bad property .* unknown\.' "$log")
  g_abs=$(grep -oE 'abstracted [0-9]+ multiplier' "$log" | grep -oE '[0-9]+' | head -1)
  g_abs=${g_abs:-0}
  # Read the authoritative cut total from the simplify summary. A
  # carrier-backed variable-shift pair may now contribute both proved input
  # constraints and one sound mul cut, so excluding every "variable-shift"
  # progress line would undercount it. Fall back to progress-line counting
  # only when an outer timeout kills the run before the summary is printed.
  g_merged=$(grep -oE '[0-9]+ operator\(s\) simplified' "$log" |
             head -1 | grep -oE '^[0-9]+')
  if [ -z "$g_merged" ]; then
    g_merged=$(grep -Ec \
      '=> (PROVEN|RISKY-MERGE).*merge|=> PROVEN carrier-backed variable-shift mul cut' \
      "$log")
  fi
  g_merged=${g_merged:-0}
  g_constraints=$(awk '
    /appended [0-9]+ equality constraint/ {
      for (i = 1; i <= NF; ++i)
        if ($i == "appended" && $(i + 1) ~ /^[0-9]+$/) {
          n += $(i + 1)
          break
        }
    }
    /appended proven mul output equality constraint/ { ++n }
    /appended [0-9]+ proven FP\/control-guarded mul relation constraint/ {
      for (i = 1; i <= NF; ++i)
        if ($i == "appended" && $(i + 1) ~ /^[0-9]+$/) {
          n += $(i + 1)
          break
        }
    }
    END { print n + 0 }
  ' "$log")
  g_risky=$(grep -c '=> RISKY-MERGE' "$log")
  case "$rc" in
    124|137|143) g_status=TIMEOUT ;;   # timeout: TERM(143)/KILL(137)/124
    20)          g_status=unsat ;;
    10)          g_status=sat ;;
    0)           g_status=undecided ;;
    *)           g_status="err($rc)" ;;
  esac
  grep -qiE 'terminate|Assertion|Segmentation|runtime_error|abort called' "$log" \
    && g_status="$g_status/exc"
}
export -f scan_log

# --- per-property mode ------------------------------------------------------
run_prop() {
  local f="$1" p="$2" profile="$3" base log rc t0 t1 secs verdict badid
  local dpv_timeout
  local -a profile_flags extra_flags
  case "$profile" in
    412)
      dpv_timeout="${TIMEOUT:-4000}"
      profile_flags=(--solve-engine both -t "$dpv_timeout"
                     --preprocess-timeout 3000)
      ;;
    616)
      dpv_timeout="${TIMEOUT:-1800}"
      profile_flags=(--solve-engine both --abstract-methods algebra,sca
                     -t "$dpv_timeout")
      ;;
    *)
      echo "internal error: unknown benchmark profile '$profile'" >&2
      return 1
      ;;
  esac
  # DPV_FLAGS intentionally uses ordinary shell-style whitespace splitting,
  # matching the script's historical interface for additional simple flags.
  read -r -a extra_flags <<< "$DPV_FLAGS"
  base="$(basename "$f" .btor)"
  log="$OUT_DIR/logs/$base.p$p.log"
  t0=$(date +%s)
  # The outer guard gets a margin over the per-property budget: dpv's own -t
  # is the intended limit, and killing dpv in the same second it is printing
  # its UNKNOWN verdict turns a valid result into `none`.
  "$TO" -k 15 $((dpv_timeout + 60)) "$BIN" "${profile_flags[@]}" \
    "${extra_flags[@]}" --property "$p" -j "$JOBS" "$f" \
    > "$log" 2>&1
  rc=$?
  t1=$(date +%s); secs=$((t1 - t0))
  scan_log "$log" "$rc"
  # Exactly one property per run, so its verdict is a single word. `none` means
  # the run was killed before it could report anything.
  if   [ "$g_sat"     -gt 0 ]; then verdict=sat
  elif [ "$g_unsat"   -gt 0 ]; then verdict=unsat
  elif [ "$g_unknown" -gt 0 ]; then verdict=unknown
  else                              verdict=none
  fi
  badid=$(grep -oE 'Bad property [0-9]+' "$log" | head -1 | grep -oE '[0-9]+')
  # Concurrent single-line appends are atomic (< PIPE_BUF). Derive the path from
  # OUT_DIR (exported): $SUMMARY is a parent-shell local, invisible to the child.
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$base" "$p" "${badid:-?}" "$verdict" "$g_status" "$secs" "$g_abs" \
    "$g_merged" "$g_constraints" "$g_risky" >> "$OUT_DIR/summary.tsv"
  echo "[done] $base p$p  $verdict  ${secs}s  ($g_status abs=$g_abs merged=$g_merged constraints=$g_constraints)"
}
export -f run_prop

export TO TIMEOUT BIN DPV_FLAGS OUT_DIR JOBS

# Work list: one "<file> <property-index>" line per bad. The count comes straight
# from the file, which is exactly what --property indexes into.
WORK412="$OUT_DIR/worklist-412.txt"
WORK616="$OUT_DIR/worklist-616.txt"
: > "$WORK412"
: > "$WORK616"
ncases=0
n412=0
n616=0
for f in "$BENCH_DIR"/*.btor; do
  base="$(basename "$f" .btor)"
  case "$base" in
    412*) target="$WORK412"; group=412 ;;
    616*) target="$WORK616"; group=616 ;;
    *) echo "note: $base is outside the documented 412/616 release suites, skipped"; continue ;;
  esac
  n=$(grep -cE '^[0-9]+ bad ' "$f")
  [ "$n" -gt 0 ] || { echo "note: $(basename "$f") has no bad property, skipped"; continue; }
  ncases=$((ncases + 1))
  case "$group" in
    412) n412=$((n412 + 1)) ;;
    616) n616=$((n616 + 1)) ;;
  esac
  i=0
  while [ "$i" -lt "$n" ]; do echo "$f $i" >> "$target"; i=$((i + 1)); done
done
nprops412=$(wc -l < "$WORK412" | tr -d ' ')
nprops616=$(wc -l < "$WORK616" | tr -d ' ')
nprops=$((nprops412 + nprops616))
[ "$nprops" -gt 0 ] || { echo "no documented 412/616 benchmark properties found"; exit 1; }

printf 'file\tprop\tbad_id\tverdict\tstatus\tsecs\tabstracted\tmerged\tconstraints\trisky\n' \
  > "$SUMMARY"
echo ">> $ncases cases / $nprops properties, JOBS=$JOBS"
echo ">> 412: $n412 cases / $nprops412 properties; -t ${TIMEOUT:-4000}, preprocess=3000, PAR=${PAR:-4}"
echo ">> 616 (all, including 616_casesplit_a): $n616 cases / $nprops616 properties; -t ${TIMEOUT:-1800}, PAR=${PAR:-4}"
[ -z "$DPV_FLAGS" ] || echo ">> extra flags: $DPV_FLAGS"

# Run the documented profiles separately because 412 and 616 use different
# outer parallelism. `< worklist` rather than `xargs -a` is portable.
if [ -s "$WORK412" ]; then
  xargs -P "${PAR:-4}" -L1 bash -c 'run_prop "$0" "$1" 412' < "$WORK412"
fi
if [ -s "$WORK616" ]; then
  xargs -P "${PAR:-4}" -L1 bash -c 'run_prop "$0" "$1" 616' < "$WORK616"
fi

echo
echo "=== verdict distribution (per property) ==="
awk -F'\t' 'NR>1{c[$4]++} END{for(k in c) printf "  %-10s %d\n",k,c[k]}' "$SUMMARY"

# Per-case rollup on the END-TO-END criterion: a case counts as solved only when
# EVERY one of its properties came back decided (sat or unsat). One undecided
# property means the case is not solved, however many others were.
BYCASE="$OUT_DIR/by-case.tsv"
awk -F'\t' 'NR>1{
    n[$1]++; secs[$1]+=$6;
    if ($4=="sat") s[$1]++; else if ($4=="unsat") u[$1]++; else gap[$1]++;
  }
  END{
    for (f in n) {
      st = (gap[f] ? "UNSOLVED" : (s[f] ? "some-sat" : "all-unsat"));
      printf "%s\t%d\t%d\t%d\t%d\t%s\t%d\n", f, n[f], s[f], u[f], gap[f], st, secs[f];
    }
  }' "$SUMMARY" | sort > "$BYCASE.body"
printf 'file\tprops\tsat\tunsat\tgap\tstatus\tsecs\n' > "$BYCASE"
cat "$BYCASE.body" >> "$BYCASE"; rm -f "$BYCASE.body"

echo "=== end-to-end per case (solved only if EVERY property is decided) ==="
awk -F'\t' 'NR>1{c[$6]++} END{for(k in c) printf "  %-10s %d\n",k,c[k]}' "$BYCASE"
solved=$(awk -F'\t' 'NR>1 && $6!="UNSOLVED"' "$BYCASE" | wc -l | tr -d ' ')
echo "  --> solved end to end: $solved / $ncases"
echo "=== summary: $SUMMARY   per-case: $BYCASE ==="
