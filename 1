#!/bin/bash
#
# BMC 批量实验脚本
# 对 benchmark 目录下所有 .btor2 文件运行 bmc，支持可调并行度
#
# 用法:
#   ./run_bmc_exp.sh [并行度] [iteration] [最大frame] [find_unsat] [find_sat] [resume|fresh]
#
# 示例:
#   ./run_bmc_exp.sh          # 默认并行度 10，并自动续跑
#   ./run_bmc_exp.sh 20       # 并行度 20
#   ./run_bmc_exp.sh 10 300 15 300 1  # 自定义所有参数
#   ./run_bmc_exp.sh 10 100 30 20 1 fresh   # 忽略已有日志，重跑全部 case
#

set -o pipefail

# ==================== 可配置参数 ====================

# 并行度（第一个命令行参数，默认 10）
PARALLEL=${1:-20}

# BMC 参数（命令行参数 2-5，带默认值）
ITERATION=${2:-200}
MAX_BOUND=${3:-50}
FIND_UNSAT=${4:-50}
FIND_SAT=${5:-1}
RUN_MODE=${6:-resume}

# 每个 case（包含其所有 frame）的总时间上限，单位秒
CASE_TIMEOUT=${CASE_TIMEOUT:-3600}

# 路径配置
BMC_BIN="/home/jiongming/desktop/FORWORD/build/bmc"                                                  # bmc 可执行文件
BENCHMARK_DIR="/home/jiongming/desktop/forword_exp/benchmark_fixed" # 测试用例目录
LOG_DIR="/home/jiongming/desktop/forword_exp/exp5"                         # 日志输出目录

# ==================== 初始化 ====================

mkdir -p "$LOG_DIR"

if ! [[ "$MAX_BOUND" =~ ^[1-9][0-9]*$ ]]; then
    echo "[ERROR] 最大frame必须是大于等于1的整数，当前值: $MAX_BOUND" >&2
    exit 2
fi

if [ "$RUN_MODE" != "fresh" ] && [ "$RUN_MODE" != "resume" ] && [ "$RUN_MODE" != "--resume" ]; then
    echo "[ERROR] 第六个参数只能是 resume/--resume 或 fresh" >&2
    exit 2
fi

if [ "$RUN_MODE" = "--resume" ]; then
    RUN_MODE="resume"
fi

RUN_CONFIG="iteration=$ITERATION max_bound=$MAX_BOUND find_unsat=$FIND_UNSAT find_sat=$FIND_SAT case_timeout=$CASE_TIMEOUT"

# 统计信息
TOTAL=$(find "$BENCHMARK_DIR" -name "*.btor2" -type f | wc -l)
PASS_FILE="$LOG_DIR/.pass_count"
FAIL_FILE="$LOG_DIR/.fail_count"
TIMEOUT_FILE="$LOG_DIR/.timeout_count"
SKIP_FILE="$LOG_DIR/.skip_count"
echo 0 > "$PASS_FILE"
echo 0 > "$FAIL_FILE"
echo 0 > "$TIMEOUT_FILE"
echo 0 > "$SKIP_FILE"

increment_counter() {
    local counter_file="$1"
    (
        flock -x 200
        local cnt
        cnt=$(cat "$counter_file")
        echo $((cnt + 1)) > "$counter_file"
    ) 200>"$LOG_DIR/.counter_lock"
}

# ==================== 单个任务执行函数 ====================

run_bmc() {
    local btor2_file="$1"

    # 生成日志文件名：用相对路径，斜杠替换为下划线
    local rel_path="${btor2_file#$BENCHMARK_DIR/}"
    local case_name="${rel_path%.btor2}"
    local case_name_clean="${case_name//\//_}"
    local log_file="$LOG_DIR/${case_name_clean}.log"

    local frame frame_log exit_code case_status="COMPLETED" stop_frame=0
    local case_start now remaining last_completed_frame=0 solve_result="UNKNOWN"

    if [ "$RUN_MODE" = "resume" ] && [ -f "$log_file" ] \
        && grep -Fqx "RUN_CONFIG: $RUN_CONFIG" "$log_file" \
        && grep -q '^CASE_COMPLETE: yes$' "$log_file"; then
        local saved_status saved_result
        saved_status=$(awk -F': ' '/^CASE_STATUS: /{value=$2} END{print value}' "$log_file")
        saved_result=$(awk -F': ' '/^SOLVE_RESULT: /{value=$2} END{print value}' "$log_file")

        echo "[$(date '+%Y-%m-%d %H:%M:%S')] SKIP: $case_name_clean ($saved_status; $saved_result)"
        increment_counter "$SKIP_FILE"
        if [ "$saved_status" = "TIMEOUT" ]; then
            increment_counter "$TIMEOUT_FILE"
        fi
        if { [ "$saved_status" = "COMPLETED" ] || [ "$saved_status" = "TIMEOUT" ]; } \
            && [[ "$saved_result" == PASS* ]]; then
            increment_counter "$PASS_FILE"
            return 0
        fi
        increment_counter "$FAIL_FILE"
        return 1
    fi

    : > "$log_file"
    case_start=$(date +%s)
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting: $case_name_clean (frames 1..$MAX_BOUND, timeout=${CASE_TIMEOUT}s)" | tee -a "$log_file"
    echo "RUN_CONFIG: $RUN_CONFIG" | tee -a "$log_file"

    # 当前 bmc 只检查指定 bound，因此逐帧运行。首次发现反例或工具错误即停止。
    for ((frame = 1; frame <= MAX_BOUND; frame++)); do
        now=$(date +%s)
        remaining=$((CASE_TIMEOUT - (now - case_start)))
        if [ "$remaining" -le 0 ]; then
            case_status="TIMEOUT"
            stop_frame=$frame
            break
        fi

        frame_log="${log_file}.frame_${frame}.tmp"
        echo "===== FRAME $frame / $MAX_BOUND (case time remaining: ${remaining}s) =====" | tee -a "$log_file"

        timeout --signal=TERM --kill-after=10s "${remaining}s" \
            "$BMC_BIN" --file "$btor2_file" \
            --iteration "$ITERATION" \
            --bound "$frame" \
            --find_unsat "$FIND_UNSAT" \
            --find_sat "$FIND_SAT" \
            2>&1 | tee "$frame_log" | tee -a "$log_file"

        exit_code=${PIPESTATUS[0]}

        if [ "$exit_code" -eq 124 ] || [ "$exit_code" -eq 137 ]; then
            case_status="TIMEOUT"
            stop_frame=$frame
            echo "[TIMEOUT] Case exceeded ${CASE_TIMEOUT}s while checking frame $frame" | tee -a "$log_file"
            break
        elif [ "$exit_code" -ne 0 ]; then
            case_status="ERROR"
            stop_frame=$frame
            solve_result="UNKNOWN (tool error at frame $frame)"
            echo "CASE_RESULT: ERROR at frame $frame (exit=$exit_code)" | tee -a "$log_file"
            break
        elif grep -q '^\[RESULT\] Failed at bound ' "$frame_log"; then
            case_status="VIOLATION"
            stop_frame=$frame
            solve_result="FAIL at frame $frame"
            echo "CASE_RESULT: VIOLATION at frame $frame" | tee -a "$log_file"
            break
        elif ! grep -q "^\[RESULT\] Bound $frame passed\." "$frame_log"; then
            case_status="ERROR"
            stop_frame=$frame
            solve_result="UNKNOWN (missing result at frame $frame)"
            echo "CASE_RESULT: ERROR at frame $frame (missing recognized result)" | tee -a "$log_file"
            break
        fi

        last_completed_frame=$frame
        solve_result="PASS through frame $frame"
        rm -f "$frame_log"
    done

    rm -f "${log_file}.frame_"*.tmp

    if [ "$case_status" = "COMPLETED" ]; then
        solve_result="PASS through frame $MAX_BOUND"
        echo "CASE_RESULT: PASS through frame $MAX_BOUND" | tee -a "$log_file"
        echo "CASE_STATUS: COMPLETED" | tee -a "$log_file"
        echo "SOLVE_RESULT: $solve_result" | tee -a "$log_file"
        echo "CASE_COMPLETE: yes" | tee -a "$log_file"
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] PASS: $case_name_clean (frames 1..$MAX_BOUND)"
        increment_counter "$PASS_FILE"
    elif [ "$case_status" = "TIMEOUT" ]; then
        if [ "$last_completed_frame" -gt 0 ]; then
            solve_result="PASS through frame $last_completed_frame"
        else
            solve_result="UNKNOWN (no frame completed)"
        fi
        echo "CASE_RESULT: TIMEOUT at frame $stop_frame; previous result: $solve_result" | tee -a "$log_file"
        echo "CASE_STATUS: TIMEOUT" | tee -a "$log_file"
        echo "SOLVE_RESULT: $solve_result" | tee -a "$log_file"
        echo "CASE_COMPLETE: yes" | tee -a "$log_file"
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] TIMEOUT: $case_name_clean ($solve_result)"
        increment_counter "$TIMEOUT_FILE"
        if [[ "$solve_result" == PASS* ]]; then
            increment_counter "$PASS_FILE"
        else
            increment_counter "$FAIL_FILE"
        fi
    else
        echo "CASE_STATUS: $case_status" | tee -a "$log_file"
        echo "SOLVE_RESULT: $solve_result" | tee -a "$log_file"
        echo "CASE_COMPLETE: yes" | tee -a "$log_file"
        echo "[$(date '+%Y-%m-%d %H:%M:%S')] FAIL ($case_status at frame $stop_frame): $case_name_clean"
        increment_counter "$FAIL_FILE"
    fi

    [[ "$solve_result" == PASS* ]]
}

# 导出函数和变量供 xargs 子进程使用
export -f run_bmc increment_counter
export BMC_BIN BENCHMARK_DIR LOG_DIR ITERATION MAX_BOUND FIND_UNSAT FIND_SAT RUN_MODE CASE_TIMEOUT
export PASS_FILE FAIL_FILE TIMEOUT_FILE SKIP_FILE RUN_CONFIG

# ==================== 打印实验配置 ====================

echo "============================================"
echo "  BMC 批量实验"
echo "============================================"
echo "  BMC binary:    $BMC_BIN"
echo "  Benchmark dir: $BENCHMARK_DIR"
echo "  Log dir:       $LOG_DIR"
echo "  Test cases:    $TOTAL"
echo "  Parallelism:   $PARALLEL"
echo "  Iteration:     $ITERATION"
echo "  Frames:        1..$MAX_BOUND"
echo "  Find unsat:    $FIND_UNSAT"
echo "  Find sat:      $FIND_SAT"
echo "  Case timeout:  ${CASE_TIMEOUT}s"
echo "  Run mode:      $RUN_MODE"
echo "============================================"
echo ""

START_TIME=$(date +%s)

# ==================== 并行执行 ====================

find "$BENCHMARK_DIR" -name "*.btor2" -type f | sort | \
    xargs -P "$PARALLEL" -I {} bash -c 'run_bmc "$@"' _ {}

# ==================== 结果汇总 ====================

END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))
PASS_CNT=$(cat "$PASS_FILE")
FAIL_CNT=$(cat "$FAIL_FILE")
TIMEOUT_CNT=$(cat "$TIMEOUT_FILE")
SKIP_CNT=$(cat "$SKIP_FILE")

echo ""
echo "============================================"
echo "  实验完成"
echo "============================================"
echo "  总用例数:     $TOTAL"
echo "  通过:         $PASS_CNT"
echo "  失败:         $FAIL_CNT"
echo "  超时:         $TIMEOUT_CNT"
echo "  Resume跳过:   $SKIP_CNT"
echo "  耗时:         ${ELAPSED}s ($((ELAPSED / 60))m $((ELAPSED % 60))s)"
echo "  日志目录:     $LOG_DIR"
echo "============================================"

# 列出失败的用例
if [ "$FAIL_CNT" -gt 0 ]; then
    echo ""
    echo "失败用例列表:"
    grep -l '^CASE_STATUS: \(VIOLATION\|ERROR\)' "$LOG_DIR"/*.log 2>/dev/null | while read f; do
        basename "$f" .log
    done
fi

# 清理临时文件
rm -f "$PASS_FILE" "$FAIL_FILE" "$TIMEOUT_FILE" "$SKIP_FILE" "$LOG_DIR/.counter_lock"
